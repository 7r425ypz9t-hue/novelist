    "@tiptap/starter-kit": "3.32.0",
    "idb-keyval": "6.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.3.0",
