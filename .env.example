# Copy to .env (never commit .env). All secrets stay on the server.
NIS_DB_PASSWORD=change-me-to-a-long-random-string
# Models are OFF by default. Options: disabled | anthropic | openai_compatible (e.g. a local Ollama at http://host.docker.internal:11434/v1)
NIS_LLM_PROVIDER=disabled
NIS_LLM_MODEL=
NIS_LLM_BASE_URL=
NIS_LLM_API_KEY=
# Optional, to show estimated costs (USD per million tokens) — never hard-coded:
# NIS_LLM_PRICE_IN_PER_MTOK=
# NIS_LLM_PRICE_OUT_PER_MTOK=
NIS_ALLOW_REGISTRATION=true
# Encryption at rest for manuscript text (generate with: nis new-key). Losing it makes encrypted rows unreadable —
# keep it in a secrets manager, separately from database backups.
NIS_MASTER_KEY=
# Host folder for scripts/compose-backup.sh output; mounted read-only so `nis doctor` can report backup age.
NIS_BACKUP_HOST_DIR=../backups
